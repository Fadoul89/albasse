# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mobile Money - Tchad : JAMAIS de clé marchande ici. Tout ce qui commence par EXPO_PUBLIC_ est copié dans le site et lisible par tous.
# Les clés Airtel / Moov iront dans les Secrets d'une fonction serveur Supabase (voir src/lib/payments/airtelMoney.ts).

# Stripe (integration future)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudinary (photos des articles, catégories, publicités, avatar de Zara) : cloud name et upload preset
# non signé, les deux faits pour être publics (comme les clés EXPO_PUBLIC_ ci-dessus) — aucun secret ici.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=c3sblcwg
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=albasse_shopping
